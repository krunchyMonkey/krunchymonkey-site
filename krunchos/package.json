{
  "name": "krunchos-preview",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.e2e.json",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run build",
    "test:e2e": "playwright test",
    "test:e2e:functional": "playwright test spec.ts",
    "test:e2e:headed": "playwright test --headed --project=desktop-chromium",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "test:e2e:visual": "playwright test visual.ts",
    "test:e2e:update-snapshots": "playwright test visual.ts --update-snapshots=all"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "radix-ui": "^1.6.1",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "tailwind-merge": "^3.2.0"
  },
  "devDependencies": {
    "@eslint/js": "9.25.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "^4.3.2",
    "@testing-library/react": "16.2.0",
    "@types/node": "22.20.5",
    "@types/react": "19.0.12",
    "@types/react-dom": "19.0.4",
    "@vitejs/plugin-react": "4.3.4",
    "eslint": "9.25.1",
    "eslint-import-resolver-typescript": "4.4.4",
    "eslint-plugin-import-x": "4.16.1",
    "jsdom": "26.0.0",
    "prettier": "3.5.3",
    "tailwindcss": "^4.3.2",
    "typescript": "5.8.3",
    "typescript-eslint": "8.31.0",
    "vite": "6.2.6",
    "vitest": "3.1.1"
  }
}
